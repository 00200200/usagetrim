diff --git a/src/billing.py b/src/billing.py
new file mode 100644
index 0000000..47ad935
--- /dev/null
+++ b/src/billing.py
@@ -0,0 +1,10 @@
+from decimal import Decimal
+
+
+def invoice_total(subtotal: Decimal, shipping: Decimal) -> Decimal:
+    return subtotal
+
+
+def receipt_message(subtotal: Decimal, shipping: Decimal) -> str:
+    total = invoice_total(subtotal, shipping)
+    return f"Invoice total: {total}"
